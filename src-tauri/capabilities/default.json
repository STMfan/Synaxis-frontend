{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "Only the locally bundled main window can use IPC and HTTP. Server selection is validated in bridge.ts; requests never follow redirects.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:event:allow-emit",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "http://*:*/*"
        },
        {
          "url": "https://*:*/*"
        }
      ]
    },
    "secure-keystore:default"
  ]
}
