{
  "name": "synaxis-client",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "dev:desktop": "tauri dev",
    "check": "tsc --noEmit && node scripts/check-architecture.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "assets": "node scripts/prepare-assets.mjs",
    "build": "npm run assets && npm run check && vite build && node scripts/check-size.mjs web && npm run check:notices",
    "build:win": "node scripts/build-native.mjs win",
    "build:mac": "node scripts/build-native.mjs mac",
    "build:linux": "node scripts/build-native.mjs linux",
    "tauri": "tauri",
    "build:android": "node scripts/build-android.mjs",
    "check:contract": "node scripts/check-contract.mjs",
    "check:publication": "node scripts/publication.mjs --check",
    "export:source": "node scripts/publication.mjs --output releases/source-1.0.0",
    "test:browser": "node scripts/test-browser.mjs",
    "check:notices": "node scripts/prepare-notices.mjs --check"
  },
  "dependencies": {
    "@mathjax/mathjax-tex-font": "^4.1.3",
    "@mathjax/src": "^4.0.0",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-http": "^2.0.0",
    "dompurify": "^3.2.0",
    "marked": "^16.0.0",
    "preact": "^10.27.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "license": "MIT"
}
